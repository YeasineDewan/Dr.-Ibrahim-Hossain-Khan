# Dr. Ibrahim Clinic - Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Custom auth domain
# NEXT_PUBLIC_SUPABASE_AUTH_URL=https://your-project-id.supabase.co/auth/v1

# Optional: Storage bucket names (if different from defaults)
# SUPABASE_BUCKET_GALLERY=clinic-gallery
# SUPABASE_BUCKET_PRESCRIPTIONS=prescription-pdfs
# SUPABASE_BUCKET_AVATARS=user-avatars